<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:j2ee="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
	version="3.0">

	<context-param>
		<param-name>logConfigPath</param-name>
		<param-value>/apps/OBC/obc-web-api.log4j.conf</param-value>
	</context-param>
	<context-param>
		<param-name>dbConfigPath</param-name>
		<param-value>/apps/OBC/obc-web-api.dbconfig.xml</param-value>
	</context-param>
    <context-param>
		<param-name>refreshCacheMinutes</param-name>
		<param-value>10</param-value>
	</context-param>

	<session-config>
		<session-timeout>30</session-timeout>
		<cookie-config>
			<http-only>true</http-only>
		</cookie-config>
	</session-config>

	<servlet>
		<servlet-name>InitializerServlet</servlet-name>
		<servlet-class>
			com.figstreet.service.InitializerServlet
		</servlet-class>
		<load-on-startup>1</load-on-startup>
	</servlet>

	<filter>
	    <filter-name>HttpHeaderSecurity</filter-name>
	    <filter-class>org.apache.catalina.filters.HttpHeaderSecurityFilter</filter-class>
	    <async-supported>true</async-supported>
	    <init-param>
	       <param-name>antiClickJackingEnabled</param-name>
	       <param-value>true</param-value>
	    </init-param>
	    <init-param>
	       <param-name>antiClickJackingOption</param-name>
	       <param-value>SAMEORIGIN</param-value>
	    </init-param>
	    <init-param>
	       <param-name>xssProtectionEnabled</param-name>
	       <param-value>true</param-value>
	    </init-param>
	</filter>
	<filter-mapping>
	    <filter-name>HttpHeaderSecurity</filter-name>
	    <url-pattern>/*</url-pattern>
	</filter-mapping>

</web-app>